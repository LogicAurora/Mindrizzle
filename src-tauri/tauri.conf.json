{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Mindrizzle",
  "version": "0.0.1",
  "identifier": "com.LogicAurora.Mindrizzle",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Mindrizzle",
        "width": 800,
        "height": 600,
        "visible": false,
        "resizable": true,
        "decorations": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEZBQUFCOTU0OUVGNDI3QTMKUldTakovU2VWTG1xK25RQ2d4WDBHTjdHOTVEUXhGQWdzSm5MZkR4Q3BpYnQ5ZURuQi96WEdTR0oK",
      "endpoints": [
        "https://github.com/LogicAurora/Mindrizzle/releases/latest/download/latest.json"
      ]
    }
  },
  "bundle": {
    "createUpdaterArtifacts": true,
    "active": true,
    "targets": "all",
    "publisher": "LogicAurora",
    "homepage": "https://github.com/LogicAurora/Mindrizzle",
    "copyright": "Copyright © 2026 The LogicAurora Authors",
    "category": "Productivity",
    "shortDescription": "Catch your mind drizzle.",
    "longDescription": "桌面优先的画布式笔记应用：笔记拆成可独立编辑和移动的内容块，让想法有处可落，让笔记自然成形，记录顺序不必等于最终结构。",
    "license": "GPL-3.0-only",
    "licenseFile": "../LICENSE",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "linux": {
      "appimage": {
        "bundleMediaFramework": false,
        "files": {}
      },
      "deb": {
        "section": "editors",
        "files": {}
      },
      "rpm": {
        "epoch": 0,
        "files": {},
        "release": "1"
      }
    }
  }
}
