{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Mindrizzle",
  "version": "0.0.1-alpha.4",
  "identifier": "com.LogicAurora.Mindrizzle",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Mindrizzle",
        "width": 800,
        "height": 600,
        "visible": false,
        "resizable": true,
        "decorations": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEZBQUFCOTU0OUVGNDI3QTMKUldTakovU2VWTG1xK25RQ2d4WDBHTjdHOTVEUXhGQWdzSm5MZkR4Q3BpYnQ5ZURuQi96WEdTR0oK",
      "endpoints": [
        "https://raw.githubusercontent.com/LogicAurora/Mindrizzle/main/channel/stable-latest.json"
      ]
    }
  },
  "bundle": {
    "createUpdaterArtifacts": true,
    "active": true,
    "targets": "all",
    "publisher": "LogicAurora",
    "homepage": "https://github.com/LogicAurora/Mindrizzle",
    "copyright": "Copyright © 2026 The LogicAurora Authors",
    "category": "Productivity",
    "shortDescription": "Catch your mind drizzle.",
    "longDescription": "Mindrizzle 是一款桌面优先的画布式笔记应用，适合那些还没准备好写成章节、却值得先记下来的想法。与必须从标题一路写到结尾的长文档不同，Mindrizzle 把笔记拆成可以独立编辑和移动的内容块，让记录顺序不必等于最终结构。",
    "license": "GPL-3.0-only",
    "licenseFile": "../LICENSE",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "linux": {
      "appimage": {
        "bundleMediaFramework": false,
        "files": {
          "usr/share/icons/hicolor/32x32/mimetypes/application-x-mindrizzle-mdrf.png": "icons/mimetypes/32x32.png",
          "usr/share/icons/hicolor/48x48/mimetypes/application-x-mindrizzle-mdrf.png": "icons/mimetypes/48x48.png",
          "usr/share/icons/hicolor/64x64/mimetypes/application-x-mindrizzle-mdrf.png": "icons/mimetypes/64x64.png",
          "usr/share/icons/hicolor/128x128/mimetypes/application-x-mindrizzle-mdrf.png": "icons/mimetypes/128x128.png",
          "usr/share/icons/hicolor/256x256/mimetypes/application-x-mindrizzle-mdrf.png": "icons/mimetypes/256x256.png",
          "usr/share/icons/hicolor/512x512/mimetypes/application-x-mindrizzle-mdrf.png": "icons/mimetypes/512x512.png",
          "usr/share/icons/hicolor/scalable/mimetypes/application-x-mindrizzle-mdrf.svg": "icons/mimetypes/application-x-mindrizzle-mdrf.svg",
          "usr/share/mime/packages/application-x-mindrizzle-mdrf.xml": "packaging/mime/application-x-mindrizzle-mdrf.xml"
        }
      },
      "deb": {
        "section": "editors",
        "files": {
          "/usr/share/icons/hicolor/32x32/mimetypes/application-x-mindrizzle-mdrf.png": "icons/mimetypes/32x32.png",
          "/usr/share/icons/hicolor/48x48/mimetypes/application-x-mindrizzle-mdrf.png": "icons/mimetypes/48x48.png",
          "/usr/share/icons/hicolor/64x64/mimetypes/application-x-mindrizzle-mdrf.png": "icons/mimetypes/64x64.png",
          "/usr/share/icons/hicolor/128x128/mimetypes/application-x-mindrizzle-mdrf.png": "icons/mimetypes/128x128.png",
          "/usr/share/icons/hicolor/256x256/mimetypes/application-x-mindrizzle-mdrf.png": "icons/mimetypes/256x256.png",
          "/usr/share/icons/hicolor/512x512/mimetypes/application-x-mindrizzle-mdrf.png": "icons/mimetypes/512x512.png",
          "/usr/share/icons/hicolor/scalable/mimetypes/application-x-mindrizzle-mdrf.svg": "icons/mimetypes/application-x-mindrizzle-mdrf.svg",
          "/usr/share/mime/packages/application-x-mindrizzle-mdrf.xml": "packaging/mime/application-x-mindrizzle-mdrf.xml"
        },
        "postInstallScript": "packaging/mime/postinst.sh",
        "postRemoveScript": "packaging/mime/postrm.sh",
        "desktopTemplate": "packaging/mindrizzle.desktop"
      },
      "rpm": {
        "epoch": 0,
        "files": {
          "/usr/share/icons/hicolor/32x32/mimetypes/application-x-mindrizzle-mdrf.png": "icons/mimetypes/32x32.png",
          "/usr/share/icons/hicolor/48x48/mimetypes/application-x-mindrizzle-mdrf.png": "icons/mimetypes/48x48.png",
          "/usr/share/icons/hicolor/64x64/mimetypes/application-x-mindrizzle-mdrf.png": "icons/mimetypes/64x64.png",
          "/usr/share/icons/hicolor/128x128/mimetypes/application-x-mindrizzle-mdrf.png": "icons/mimetypes/128x128.png",
          "/usr/share/icons/hicolor/256x256/mimetypes/application-x-mindrizzle-mdrf.png": "icons/mimetypes/256x256.png",
          "/usr/share/icons/hicolor/512x512/mimetypes/application-x-mindrizzle-mdrf.png": "icons/mimetypes/512x512.png",
          "/usr/share/icons/hicolor/scalable/mimetypes/application-x-mindrizzle-mdrf.svg": "icons/mimetypes/application-x-mindrizzle-mdrf.svg",
          "/usr/share/mime/packages/application-x-mindrizzle-mdrf.xml": "packaging/mime/application-x-mindrizzle-mdrf.xml"
        },
        "release": "1",
        "postInstallScript": "packaging/mime/postinst.sh",
        "postRemoveScript": "packaging/mime/postrm.sh",
        "desktopTemplate": "packaging/mindrizzle.desktop"
      }
    },
    "fileAssociations": [
      {
        "ext": ["mdrf"],
        "name": "Mindrizzle Note",
        "description": "Mindrizzle 笔记",
        "mimeType": "application/x-mindrizzle-mdrf",
        "role": "Editor",
        "rank": "Owner",
        "exportedType": {
          "identifier": "com.logicaurora.mindrizzle.mdrf",
          "conformsTo": ["public.data"]
        }
      }
    ],
    "resources": {
      "icons/mimetypes/mdrf.ico": "mdrf.ico"
    },
    "windows": {
      "nsis": {
        "installerHooks": "packaging/windows-file-icon.nsh"
      }
    },
    "macOS": {
      "files": {
        "Resources/mdrf.icns": "icons/mimetypes/mdrf.icns"
      },
      "infoPlist": "packaging/macos-info.plist"
    }
  }
}
